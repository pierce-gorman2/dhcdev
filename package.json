{
  "name": "dhc-buildout-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --d1=DB=REPLACE-WITH-D1-DATABASE-ID --compatibility-date=2024-09-01",
    "db:migrate:local": "wrangler d1 execute dhc_tracker_db --local --file=./migrations/schema.sql",
    "db:seed:local": "wrangler d1 execute dhc_tracker_db --local --file=./migrations/seed.sql",
    "db:migrate:remote": "wrangler d1 execute dhc_tracker_db --remote --file=./migrations/schema.sql",
    "db:seed:remote": "wrangler d1 execute dhc_tracker_db --remote --file=./migrations/seed.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wrangler": "^3.78.0"
  }
}
